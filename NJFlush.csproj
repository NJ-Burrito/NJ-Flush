<!-- Used by the tests and mutation testing only: the shipped exe is still built by build.cmd (csc, .NET Framework 4.x). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <NoWarn>SYSLIB0014;CS0618;CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AssemblyName>NJ-Flush</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NJFlush.cs" />
    <EmbeddedResource Include="flush-*.wav" LogicalName="%(Filename)%(Extension)" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
